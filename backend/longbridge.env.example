# Stable Longbridge endpoints for local development.
LONGBRIDGE_HTTP_URL=https://openapi.longbridge.com
LONGBRIDGE_QUOTE_WS_URL=wss://openapi-quote.longbridge.com/v2
LONGBRIDGE_TRADE_WS_URL=wss://openapi-trade.longbridge.com/v2

# Quant selector point-in-time source bundle and authoritative product metadata.
QUANT_SELECTOR_BUNDLE_PATH=data/quant-selector/source-bundle.json
QUANT_SELECTOR_PRODUCT_METADATA_PATH=data/quant-selector/product-metadata.json
QUANT_SELECTOR_OUTCOME_BUNDLE_PATH=data/quant-selector/outcome-bundle.json
# Shadow evaluation is opt-in because it doubles model calls for the frozen sample.
QUANT_SELECTOR_SHADOW_ENABLED=false
# Set both budgets before using shadow results as an upgrade gate.
# QUANT_SELECTOR_SHADOW_PRO_LATENCY_BUDGET_MS=60000
# QUANT_SELECTOR_SHADOW_PRO_COST_BUDGET_USD=5
# QUANT_SELECTOR_SHADOW_PRO_INPUT_COST_PER_MILLION_USD=0
# QUANT_SELECTOR_SHADOW_PRO_OUTPUT_COST_PER_MILLION_USD=0
DEEPSEEK_BASE_URL=https://api.deepseek.com
